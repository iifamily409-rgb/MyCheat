<?xml version="1.0" encoding="utf-8"?> 
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" 
    android:layout_width="wrap_content" android:layout_height="wrap_content" 
    android:orientation="vertical" android:background="#AA000000" android:padding="12dp"> 
    <TextView android:id="@+id/tv_status" android:text="Cheat Active" android:textColor="#00FF00" android:textSize="16sp" /> 
    <SeekBar android:id="@+id/power_seek" android:layout_width="150dp" android:layout_height="wrap_content" android:max="100" android:progress="50" /> 
    <Button android:id="@+id/btn_auto_shoot" android:text="AUTO SHOOT" android:background="#FF5722" android:textColor="#FFFFFF" /> 
    <Button android:id="@+id/btn_toggle_path" android:text="Toggle Path" android:background="#2196F3" /> 
</LinearLayout> 
